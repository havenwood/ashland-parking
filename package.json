    "fetch-osm": "node scripts/fetch-osm.ts"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
