{
  "name": "ashland-parking",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/make-pdfs.ts",
    "preview": "astro preview",
