---
import { sources } from '../data/sources.ts';
import type { SourceId } from '../data/sources.ts';
import type { Locale } from '../i18n/strings.ts';

interface Props {
  id: SourceId;
  locale: Locale;
  /** Link text; defaults to the source's title. */
  label?: string;
}

// Blocked and archived sources are flagged once, in the footer's source list.
const { id, locale, label } = Astro.props;
const source = sources[id];
---

<a href={source.url} hreflang={source.lang ?? 'en'}>{label ?? source.title[locale]}</a>
